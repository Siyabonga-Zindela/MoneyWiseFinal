# MoneyWise backend - copy to .env and fill in real values. NEVER commit .env.
ENVIRONMENT=development

# Neon PostgreSQL connection string (Neon dashboard > Connection Details).
# Use the -pooler host for the app; for Alembic migrations the direct host also works.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Brute-force protection (backed by the login_attempts table)
FAILED_LOGIN_WINDOW_MINUTES=15
FAILED_LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
RATE_LIMIT_AUTH=5/minute

# POPIA - salt for hashing IP addresses (raw IPs are never stored)
IP_HASH_SALT=change-me

# CORS - allowed frontend origins, comma separated
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# AI analysis (optional) - /api/v1/analysis always works with the deterministic
# rule engine; set these to add OpenRouter AI explanations on top of the verdict.
# Without a key the API still returns category, score, indicators and next steps.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=30
