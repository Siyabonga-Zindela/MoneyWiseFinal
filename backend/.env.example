# MoneyWise backend - copy to .env and fill in real values. NEVER commit .env.
ENVIRONMENT=development

# Neon dashboard > Connection Details (use the -pooler host for the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Brute-force protection
FAILED_LOGIN_WINDOW_MINUTES=15
FAILED_LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
RATE_LIMIT_AUTH=5/minute

# Public scam-report endpoint
RATE_LIMIT_REPORTS=10/minute
MAX_BODY_MB=8

# POPIA - IP hashing salt
IP_HASH_SALT=change-me

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# AI analysis (optional) - leave empty to use the deterministic engine only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
